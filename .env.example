# Copy to .env and fill in. All vars are prefixed SENTINEL_.

# Database. Defaults to a local SQLite file; swap for Postgres in production:
#   SENTINEL_DATABASE_URL=postgresql+psycopg://sentinel:sentinel@localhost:5432/sentinel
SENTINEL_DATABASE_URL=sqlite:///./sentinel.db

# Needed from M2 onward (the Claude risk scorer). Not required for M0/M1.
SENTINEL_ANTHROPIC_API_KEY=
